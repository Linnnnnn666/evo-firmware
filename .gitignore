# Build artifacts
build/
build-*/
sdkconfig
sdkconfig.old
sdkconfig.defaults.*
# 例外：fall-board 的板级构建配置（纯硬件参数，无凭据）——
# 缺它会导致 IDF 按默认 esp32 目标编译而失败，故纳入版本库
!fall-board/sdkconfig.defaults.esp32s3
*.bin
*.elf
*.map
*.o
*.a

# ESP-IDF managed components (downloaded)
managed_components/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store

# Private board configs (real credentials live here locally)
main/boards/*.local.h
main/*_private.h
